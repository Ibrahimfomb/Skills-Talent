# Copier ce fichier en .env à la racine de backend/app/
# Ne jamais committer le fichier .env

# Base de données
DATABASE_URL=jdbc:postgresql://localhost:5432/skills_talent
DATABASE_USER=postgres
DATABASE_PASSWORD=votre_mot_de_passe

# JWT — clé secrète d'au moins 64 caractères (HS512)
JWT_SECRET=generer_une_cle_aleatoire_de_64_caracteres_minimum
JWT_EXPIRATION=86400000

# Fournisseur IA (onboarding, matching, chatbot STELLA)
AI_API_KEY=votre_cle_ici

# ============================================================
# JOB BOARD INTEGRATIONS — Multi-Regional Publishing
# ============================================================

# France Travail (Service public français)
# API: https://api.francetravail.io/partenaire/offresdemploi/v2
# Credentials: https://developer.francetravail.io
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_API_CLIENT_ID=
FRANCE_TRAVAIL_API_CLIENT_SECRET=

# LinkedIn Jobs API
# API: https://learn.microsoft.com/en-us/linkedin/talent/job-postings-api
# Credentials: https://www.linkedin.com/developers
LINKEDIN_API_BASE_URL=https://api.linkedin.com/v2
LINKEDIN_API_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# BrighterMonday (Pan-African Job Board)
# Regions: Kenya, Uganda, Nigeria, Ghana, Cameroon, Senegal, etc.
# API: https://www.brightermonday.com/about/api
# Credentials: contact partnerships@brightermonday.com
BRIGHTERMONDAY_API_BASE_URL=https://api.brightermonday.com/v1
BRIGHTERMONDAY_API_KEY=

# Jobartisan (African Job Board)
# API: https://jobartisan.io/developers
# Credentials: contact api-support@jobartisan.io
JOBARTISAN_API_BASE_URL=https://api.jobartisan.io/v1
JOBARTISAN_API_KEY=

# Generic API timeout for job board integrations
INTEGRATION_API_TIMEOUT=30000
